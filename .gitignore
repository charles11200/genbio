# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Gradle's own report/output dir - regenerated on every build, and one of
# its reports (problems-report.html) was previously committed by mistake.
/android/build/

# Claude Code local state - per-machine permission settings and scratch
# git worktrees (full copies of the project, each with a .git file that
# points at an absolute path on the machine that made it). Never shared:
# a committed worktree shows up as a broken submodule for everyone else.
.claude/
